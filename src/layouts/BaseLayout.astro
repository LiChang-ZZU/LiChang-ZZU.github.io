---
import '@/styles/global.css';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import LiveChat from '@/components/LiveChat.astro';
import BackToTop from '@/components/BackToTop.astro';
import SEO from '@/components/SEO.astro';
import type { Locale } from '@/types';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
  noindex?: boolean;
  translationPath?: string;
  canonicalOverride?: string;
}

const {
  title, description, locale = 'zh', image, type = 'website', publishedTime, updatedTime, noindex = false, translationPath, canonicalOverride
} = Astro.props;
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="expect" href="#main-content" blocking="render" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
      addEventListener('pagereveal', (event) => {
        if (!event.viewTransition) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          event.viewTransition.skipTransition();
          return;
        }
        document.documentElement.dataset.routeMotion = '';
      });
    </script>
    <SEO {...{ title, description, locale, image, type, publishedTime, updatedTime, noindex, translationPath, canonicalOverride }} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{locale === 'zh' ? '跳到主要内容' : 'Skip to content'}</a>
    <Navbar {locale} alternatePath={translationPath} />
    <main id="main-content"><slot /></main>
    <Footer {locale} />
    <BackToTop {locale} />
    <LiveChat />
    <script>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        }, { threshold: 0, rootMargin: '0px 0px -4% 0px' });
        for (const target of document.querySelectorAll<HTMLElement>('[data-reveal]')) {
          if (target.getBoundingClientRect().top < innerHeight) continue;
          target.classList.add('is-pending');
          observer.observe(target);
        }
      }
    </script>
  </body>
</html>
