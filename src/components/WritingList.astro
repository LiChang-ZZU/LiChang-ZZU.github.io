---
import { getCollection } from 'astro:content';
import type { Locale } from '@/types';
import { isPublished, sortByDate } from '@/utils/content';
import { getLocalizedPath } from '@/utils/urls';
interface Props { locale: Locale }
const { locale } = Astro.props;
const posts = sortByDate((await getCollection('blog')).filter((post) => post.data.locale === locale && isPublished(post))).slice(0, 5);
const copy = locale === 'zh'
  ? { eyebrow: '写作', title: '随笔', all: '全部文章', empty: '还没有文章。' }
  : { eyebrow: 'Writing', title: 'Essays', all: 'All writing', empty: 'No essays yet.' };
const fmt = (date: Date) => new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-GB', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(date).replace(/\//g, '.');
---
<section class="section writing" id="writing"><div class="container">
  <div class="row-head" data-reveal="fade">
    <div><p class="eyebrow">{copy.eyebrow}</p><h2>{copy.title}</h2></div>
    <a class="text-link" href={getLocalizedPath(locale, '/blog/')}>{copy.all}</a>
  </div>
  {posts.length
    ? <ul class="writing-list">
        {posts.map((post) => <li data-reveal="fade-up">
          <a href={getLocalizedPath(locale, `/blog/${post.data.slug}/`)}>
            <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            <span class="writing-title">{post.data.title}</span>
            <span class="writing-desc">{post.data.description}</span>
          </a>
        </li>)}
      </ul>
    : <p class="empty-state">{copy.empty}</p>}
</div></section>
<style>
  .row-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:1rem;margin-bottom:1.4rem}
  .row-head h2{margin:0;font-size:var(--text-2xl);letter-spacing:-.045em;line-height:1.05}
  .row-head .eyebrow{margin-bottom:.7rem}
  .writing-list{list-style:none;margin:0;padding:0}
  .writing-list li{border-top:1px solid var(--color-line)}
  .writing-list a{display:grid;grid-template-columns:7.5rem minmax(0,1.1fr) minmax(0,1.4fr);gap:1.4rem;align-items:baseline;padding:1.35rem .2rem;text-decoration:none;transition:padding-left var(--transition-base)}
  .writing-list a:hover{padding-left:.9rem}
  .writing-list time{color:var(--color-faint);font-size:var(--text-sm);font-variant-numeric:tabular-nums}
  .writing-title{font-size:var(--text-lg);font-weight:620;letter-spacing:-.02em;line-height:1.35}
  .writing-desc{color:var(--color-muted);font-size:var(--text-sm);line-height:1.65}
  .writing-list li:last-child{border-bottom:1px solid var(--color-line)}
  @media(max-width:760px){
    .writing-list a{grid-template-columns:1fr;gap:.35rem;padding:1.2rem .1rem}
    .writing-desc{display:none}
  }
</style>
