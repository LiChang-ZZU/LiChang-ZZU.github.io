---
import type { Locale } from '@/types';
import { getLocalizedPath, switchLocalePath } from '@/utils/urls';
interface Props { locale: Locale; alternatePath?: string }
const { locale, alternatePath } = Astro.props;
const next = locale === 'zh' ? 'en' : 'zh';
---
<a class="language nav-control" href={alternatePath ? getLocalizedPath(next, alternatePath) : switchLocalePath(Astro.url.pathname, next)} hreflang={next === 'zh' ? 'zh-CN' : 'en'} aria-label={locale === 'zh' ? 'Switch to English' : '切换到中文'}>{next === 'zh' ? '中' : 'EN'}</a>
<style>.language{font-size:.79rem;font-weight:660}</style>
