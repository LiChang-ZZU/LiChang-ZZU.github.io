---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@/types';
import site from '@/data/site';
import { assetUrl } from '@/utils/urls';
interface Props { publication: CollectionEntry<'publications'>; locale: Locale }
const { publication: pub, locale } = Astro.props;
const ownNames = new Set([site.name, site.nameEn, 'Chang Li'].filter(Boolean));
const links = [
  ['DOI', pub.data.doi], ['PDF', pub.data.pdf], ['Code', pub.data.code], ['Video', pub.data.video], ['Project', pub.data.project]
].filter(([,url]) => url);
const typeLabels = {
  journal: ['期刊', 'Journal'], conference: ['会议', 'Conference'], preprint: ['预印本', 'Preprint'],
  book: ['专著', 'Book'], chapter: ['章节', 'Chapter'], other: ['其他', 'Other']
} as const satisfies Record<string, readonly [string, string]>;
const typeLabel = typeLabels[pub.data.type][locale === 'zh' ? 0 : 1];
const venueText = `${pub.data.venue}${pub.data.volume ? `, ${pub.data.volume}` : ''}${pub.data.pages ? `, ${pub.data.pages}` : ''}`;
const titleHref = pub.data.doi || pub.data.pdf || pub.data.project;
---
<article class="publication notranslate" data-type={pub.data.type} data-reveal="fade-up" translate="no">
  {pub.data.thumbnail && <img class="pub-thumb" src={assetUrl(pub.data.thumbnail)} alt={pub.data.title} width="640" height="427" loading="lazy" decoding="async" />}
  <div class="pub-body">
    <div class="pub-meta"><span class="pub-type">{typeLabel}</span><span class="pub-year">{pub.data.year}</span></div>
    <h3 class="pub-title" lang="en">{titleHref ? <a href={assetUrl(titleHref)} target="_blank" rel="noopener">{pub.data.title}</a> : pub.data.title}</h3>
    <p class="authors">{pub.data.authors.map((author, i) => <>{ownNames.has(author) ? <strong>{author}</strong> : author}{i < pub.data.authors.length - 1 ? ', ' : ''}</>)}</p>
    <p class="venue" lang="en">{venueText}</p>
    {pub.data.award && <p class="award">{pub.data.award}</p>}
    {pub.data.abstract && <details class="abstract"><summary class="pressable">{locale==='zh'?'摘要':'Abstract'}</summary><p lang={locale==='zh'?'zh-CN':'en'}>{pub.data.abstract}</p></details>}
    <div class="pub-actions">{links.map(([label,url])=><a class="pressable" href={assetUrl(url)} target="_blank" rel="noopener">{label}</a>)}{pub.data.bibtex && <button class="bibtex-open pressable" type="button" data-bibtex={pub.data.bibtex}>{locale === 'zh' ? '引用' : 'BibTeX'}</button>}</div>
  </div>
</article>
<style>
  .publication{display:flex;flex-direction:column;height:100%}
  .pub-thumb{display:block;width:100%;aspect-ratio:3/2;margin:0 0 1.05rem;border-radius:var(--radius-md);background:var(--color-surface);object-fit:cover;transition:opacity var(--transition-base)}
  .publication:hover .pub-thumb{opacity:.88}
  .pub-body{display:flex;flex:1;flex-direction:column;min-width:0}
  .pub-meta{display:flex;align-items:center;gap:.6rem;margin-bottom:.4rem;color:var(--color-faint);font-size:var(--text-xs);font-variant-numeric:tabular-nums}
  .pub-type{color:var(--color-accent-strong);font-weight:700;letter-spacing:.06em;text-transform:uppercase}
  .pub-year{margin-left:auto}
  .pub-title{margin:0;font-size:1.05rem;font-weight:650;line-height:1.38;letter-spacing:-.015em}
  .pub-title a{color:inherit;text-decoration:none;transition:color var(--transition-fast)}
  .pub-title a:hover{color:var(--color-accent-strong)}
  .authors,.venue{margin:.5rem 0 0;font-size:var(--text-sm);line-height:1.55}
  .authors{color:var(--color-muted)}
  .venue{color:var(--color-faint)}
  .award{display:inline-block;width:max-content;margin:.65rem 0 0;padding:.18rem .5rem;background:var(--color-accent-soft);color:var(--color-accent-strong);font-size:var(--text-xs);font-weight:700;border-radius:var(--radius-sm)}
  .abstract{margin-top:.65rem;color:var(--color-muted);font-size:.8rem}
  .abstract summary{width:max-content;color:var(--color-accent-strong);cursor:pointer;font-weight:600}
  .abstract p{max-height:13rem;margin:.45rem 0 0;overflow:auto;padding-right:.3rem}
  @media(prefers-reduced-motion:no-preference){
    .abstract[open] p{animation:abstract-in .32s var(--ease-out) both}
    @keyframes abstract-in{from{opacity:0;translate:0 -.3rem}}
  }
  .pub-actions{display:flex;flex-wrap:wrap;gap:.45rem .95rem;margin-top:auto;padding-top:1rem}
  .pub-actions a,.pub-actions button{padding:0;border:0;background:none;color:var(--color-accent-strong);font-size:var(--text-sm);font-weight:600;text-decoration:none;cursor:pointer}
  .pub-actions a:hover,.pub-actions button:hover{text-decoration:underline}
</style>
