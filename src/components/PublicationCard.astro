---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@/types';
import site from '@/data/site';
import { assetUrl } from '@/utils/urls';
interface Props { publication: CollectionEntry<'publications'>; locale: Locale }
const { publication: pub, locale } = Astro.props;
const ownNames = new Set([site.name, site.nameEn].filter(Boolean));
const links = [
  ['DOI', pub.data.doi], ['PDF', pub.data.pdf], ['Code', pub.data.code], ['Video', pub.data.video], ['Project', pub.data.project]
].filter(([,url]) => url);
const typeLabels: Record<string, [string, string]> = {
  journal: ['期刊', 'Journal'], conference: ['会议', 'Conference'], preprint: ['预印本', 'Preprint'],
  book: ['专著', 'Book'], chapter: ['章节', 'Chapter'], other: ['其他', 'Other']
};
const typeLabel = (typeLabels[pub.data.type] ?? typeLabels.other)[locale === 'zh' ? 0 : 1];
const venueText = `${pub.data.venue}${pub.data.volume ? `, ${pub.data.volume}` : ''}${pub.data.pages ? `, ${pub.data.pages}` : ''}`;
---
<article class="publication" data-type={pub.data.type} data-reveal="fade-up">
  {pub.data.thumbnail && <img class="pub-thumb" src={assetUrl(pub.data.thumbnail)} alt={pub.data.title} width="640" height="427" loading="lazy" decoding="async" />}
  <div class="pub-body">
    <div class="pub-meta"><span class="pub-type">{typeLabel}</span><span class="pub-year">{pub.data.year}</span></div>
    <h3 class="pub-title notranslate" lang="en" translate="no">{pub.data.title}</h3>
    <p class="authors notranslate" translate="no">{pub.data.authors.map((author, i) => <>{ownNames.has(author) ? <strong>{author}</strong> : author}{i < pub.data.authors.length - 1 ? ', ' : ''}</>)}</p>
    <p class="venue notranslate" lang="en" translate="no">{venueText}</p>
    {pub.data.award && <p class="award">{pub.data.award}</p>}
    {pub.data.abstract && <details class="abstract"><summary>{locale==='zh'?'摘要':'Abstract'}</summary><p class="notranslate" lang={locale==='zh'?'zh-CN':'en'} translate="no">{pub.data.abstract}</p></details>}
    <div class="pub-actions">{links.map(([label,url])=><a href={url} target="_blank" rel="noopener">{label}</a>)}{pub.data.bibtex && <button class="bibtex-open" type="button" data-bibtex={pub.data.bibtex}>{locale === 'zh' ? '引用' : 'BibTeX'}</button>}</div>
  </div>
</article>
<style>
  .publication{display:flex;flex-direction:column;height:100%;padding:1.1rem;border:1px solid var(--color-line);border-radius:var(--radius-md);background:var(--color-surface);transition:transform var(--transition-base),border-color var(--transition-base),box-shadow var(--transition-base)}
  .publication:hover{transform:translateY(-3px);border-color:color-mix(in srgb,var(--color-accent) 45%,var(--color-line));box-shadow:var(--shadow-md)}
  .pub-thumb{display:block;width:100%;aspect-ratio:3/2;margin:0 0 1rem;border:1px solid var(--color-line);border-radius:var(--radius-sm);background:var(--color-bg);object-fit:cover}
  .pub-body{display:flex;flex:1;flex-direction:column;min-width:0}
  .pub-meta{display:flex;align-items:center;gap:.6rem;margin-bottom:.45rem;color:var(--color-faint);font-size:var(--text-xs);font-variant-numeric:tabular-nums}
  .pub-type{color:var(--color-accent-strong);font-weight:700;letter-spacing:.06em;text-transform:uppercase}
  .pub-year{margin-left:auto}
  .pub-title{margin:0;font-size:1.02rem;line-height:1.42;letter-spacing:-.012em}
  .authors,.venue{margin:.55rem 0 0;font-size:.78rem;line-height:1.55}
  .authors{color:var(--color-muted)}
  .venue{color:var(--color-faint)}
  .award{display:inline-block;width:max-content;margin:.7rem 0 0;padding:.2rem .55rem;background:var(--color-accent-soft);color:var(--color-accent-strong);font-size:var(--text-xs);font-weight:700;border-radius:var(--radius-sm)}
  .abstract{margin-top:.7rem;color:var(--color-muted);font-size:.8rem}
  .abstract summary{width:max-content;color:var(--color-accent-strong);cursor:pointer;font-weight:650}
  .abstract p{max-height:13rem;margin:.5rem 0 0;overflow:auto;padding-right:.3rem}
  .pub-actions{display:flex;flex-wrap:wrap;gap:.5rem .9rem;margin-top:auto;padding-top:.95rem;border-top:1px solid var(--color-line)}
  .pub-actions a,.pub-actions button{padding:0;border:0;background:none;color:var(--color-accent-strong);font-size:var(--text-sm);font-weight:650;text-decoration:none;cursor:pointer}
  .pub-actions a:hover,.pub-actions button:hover{text-decoration:underline}
</style>
