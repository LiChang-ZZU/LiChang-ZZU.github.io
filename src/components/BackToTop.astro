---
import type { Locale } from '@/types';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<button class="back-top glass-surface icon-button" type="button" aria-label={locale === 'zh' ? '返回顶部' : 'Back to top'} title={locale === 'zh' ? '返回顶部' : 'Back to top'}>↑</button>
<script>
  const button = document.querySelector<HTMLButtonElement>('.back-top');
  if (button) {
    const sync = () => button.classList.toggle('show', scrollY > 700);
    sync();
    addEventListener('scroll', sync, { passive: true });
    button.addEventListener('click', () => scrollTo({ top: 0 }));
  }
</script>
<style>
  .back-top{position:fixed;z-index:60;right:1rem;bottom:1rem;width:2.8rem;height:2.8rem;border-radius:50%;opacity:0;visibility:hidden;translate:0 8px;transition:opacity .22s ease,visibility .22s,translate .28s var(--ease-out),scale .28s var(--ease-out);cursor:pointer}
  .back-top.show{opacity:1;visibility:visible;translate:0 0}
</style>
