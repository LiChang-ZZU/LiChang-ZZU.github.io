---
import type { Locale } from '@/types';
import { getLocalizedPath } from '@/utils/urls';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<a class="search-button nav-control" href={getLocalizedPath(locale, '/search/')} aria-label={locale === 'zh' ? '站内搜索' : 'Search site'}>
  <span class="search-icon" aria-hidden="true"></span>
</a>
<style>
  .search-icon{position:relative;width:.75rem;height:.75rem;margin:-.1rem .1rem 0 0;border:1.5px solid currentColor;border-radius:50%}
  .search-icon::after{content:"";position:absolute;width:.32rem;height:1.5px;right:-.26rem;bottom:-.12rem;background:currentColor;border-radius:2px;rotate:46deg}
</style>
