---
interface Props { title: string; link?: string; linkLabel?: string }
const { title, link, linkLabel } = Astro.props;
---
<header class="section-header" data-reveal="fade-up">
  <h2 class="display-title">{title}</h2>
  {link && linkLabel && <a class="text-link" href={link}>{linkLabel}</a>}
</header>
<style>
  .section-header{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:.85rem 2rem;margin-bottom:clamp(1.5rem,4vw,2.6rem)}
</style>
