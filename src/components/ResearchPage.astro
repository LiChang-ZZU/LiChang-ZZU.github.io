---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PublicationCard from './PublicationCard.astro';
import ProjectCard from './ProjectCard.astro';
import BibtexDialog from './BibtexDialog.astro';
import type { Locale } from '@/types';
import { isPublished, sortByDate } from '@/utils/content';
import { hideEmptySections, splitSections } from '@/utils/markdown-html';

interface Props { locale: Locale }
const { locale } = Astro.props;
const entries = await getCollection('pages');
const entry = entries.find((x) => x.data.locale === locale && x.data.page === 'research');
if (!entry) throw new Error(`Missing ${locale}/research page content`);
await render(entry);

const agenda = splitSections(hideEmptySections(entry.rendered?.html ?? ''));
const [pubsRaw, projectsRaw] = await Promise.all([getCollection('publications'), getCollection('projects')]);
const pubs = pubsRaw.filter((x) => x.data.locale === locale && isPublished(x)).sort((a, b) => b.data.year - a.data.year);
const projects = sortByDate(projectsRaw.filter((x) => x.data.locale === locale && isPublished(x)));
const types = [...new Set(pubs.map((p) => p.data.type))];
const years = [...new Set(pubs.map((p) => p.data.year))];
const copy = locale === 'zh'
  ? { eyebrow: '研究', title: '研究', papers: '论文', papersNote: '按年份倒序排列，可按类型筛选。', all: '全部', projects: '项目', emptyPapers: '论文列表尚未发布。', emptyProjects: '项目内容尚未发布。' }
  : { eyebrow: 'Research', title: 'Research', papers: 'Publications', papersNote: 'Reverse chronological, filterable by type.', all: 'All', projects: 'Projects', emptyPapers: 'No publications published yet.', emptyProjects: 'No projects published yet.' };
---
<BaseLayout title={entry.data.title} description={entry.data.description} {locale}>
  <header class="page-head"><div class="container"><p class="eyebrow" data-reveal="fade">{copy.eyebrow}</p><h1 data-reveal="fade-up">{copy.title}</h1>{entry.data.description && <p data-reveal="fade-up" style="--stagger:1">{entry.data.description}</p>}</div></header>

  {agenda.length > 0 && <section class="section agenda"><div class="container" data-pagefind-body>
    <div class="agenda-grid">
      {agenda.map((section, index) => <article data-reveal="fade-up" style={`--stagger:${index}`}>
        <h2>{section.title}</h2>
        <div class="agenda-body" set:html={section.html} />
      </article>)}
    </div>
  </div></section>}

  {pubs.length > 0 && <section class="section" id="publications"><div class="container" data-pagefind-body>
    <div class="row-head" data-reveal="fade"><div><p class="eyebrow">{copy.eyebrow}</p><h2>{copy.papers}</h2></div><p class="note">{copy.papersNote}</p></div>
    {types.length > 1 && <div class="filters" data-pagefind-ignore data-reveal="fade"><button class="active" data-type="all">{copy.all}</button>{types.map((type) => <button data-type={type}>{type}</button>)}</div>}
    <div class="pub-list">
      {years.map((year) => <section class="year-group"><h3>{year}</h3><div class="pub-grid">{pubs.filter((publication) => publication.data.year === year).map((publication) => <PublicationCard {publication} {locale} />)}</div></section>)}
    </div>
  </div></section>}

  {projects.length > 0 && <section class="section soft" id="projects"><div class="container" data-pagefind-body>
    <div class="row-head" data-reveal="fade"><div><p class="eyebrow">{copy.eyebrow}</p><h2>{copy.projects}</h2></div></div>
    {projects.map((project, index) => <ProjectCard {project} {locale} {index} />)}
  </div></section>}
  <BibtexDialog {locale} />
</BaseLayout>
<script>
  document.querySelectorAll<HTMLButtonElement>('.filters button').forEach((button) => button.addEventListener('click', () => {
    document.querySelectorAll('.filters button').forEach((item) => item.classList.remove('active'));
    button.classList.add('active');
    document.querySelectorAll<HTMLElement>('.publication').forEach((item) => { item.hidden = button.dataset.type !== 'all' && item.dataset.type !== button.dataset.type; });
    document.querySelectorAll<HTMLElement>('.year-group').forEach((group) => { group.hidden = ![...group.querySelectorAll<HTMLElement>('.publication')].some((item) => !item.hidden); });
  }));
</script>
<style>
  .agenda-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,17rem),1fr));gap:clamp(1.6rem,4vw,3.5rem);padding-top:.4rem}
  .agenda-grid article{padding-top:1.4rem;border-top:1px solid var(--color-line)}
  .agenda-grid h2{margin:0 0 .9rem;font-size:var(--text-lg);font-weight:650;letter-spacing:-.02em}
  .agenda-body{color:var(--color-muted);font-family:var(--font-serif);font-size:1.02rem;line-height:1.85}
  .agenda-body :global(p){margin:.7em 0}
  .agenda-body :global(ul){margin:.7em 0;padding-left:1.1rem}
  .row-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:1rem;margin-bottom:2.2rem}
  .row-head h2{margin:0;font-size:var(--text-2xl);letter-spacing:-.045em;line-height:1.05}
  .row-head .eyebrow{margin-bottom:.7rem}
  .note{margin:0;color:var(--color-faint);font-size:var(--text-sm)}
  .filters{position:sticky;z-index:10;top:calc(var(--nav-height) + .5rem);display:flex;flex-wrap:wrap;gap:.45rem;margin-bottom:2rem;padding:.7rem;border:1px solid var(--color-line);border-radius:var(--radius-pill);background:var(--color-elevated);backdrop-filter:blur(14px);width:max-content;max-width:100%}
  .filters button{padding:.45rem .8rem;border:0;border-radius:var(--radius-pill);background:transparent;color:var(--color-muted);font-size:var(--text-sm);cursor:pointer}
  .filters button.active{background:var(--color-text);color:var(--color-bg)}
  .year-group{display:grid;grid-template-columns:6rem 1fr;column-gap:2rem;margin-top:3rem;align-items:start}
  .year-group > h3{position:sticky;top:calc(var(--nav-height) + 4.5rem);margin:0;color:var(--color-faint);font-size:var(--text-xl);font-variant-numeric:tabular-nums;font-weight:600}
  .soft{background:var(--color-accent-soft)}
  @media(max-width:700px){.year-group{grid-template-columns:1fr;row-gap:.8rem}.year-group > h3{position:static;margin-bottom:0}}
</style>
