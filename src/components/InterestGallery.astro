---
import type { Locale } from '@/types';
import { assetUrl } from '@/utils/urls';
import { getPhotos, photoImage, photoText } from '@/utils/photos';
import ResponsivePhoto from './ResponsivePhoto.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const photos = await getPhotos();
const formatDate = new Intl.DateTimeFormat(zh ? 'zh-CN' : 'en-GB', {
  year: 'numeric', month: 'long', timeZone: 'UTC',
});
const tiles = photos.map(({ data }) => {
  const image = photoImage(data.image, data.maxSize, data.compress);
  const ratio = image.height ? image.width / image.height : 1.33;
  return {
    image,
    ratio: Math.max(.66, Math.min(1.85, ratio)),
    date: data.date ? formatDate.format(data.date) : '',
    ...photoText(data, locale),
  };
});
const rows: Array<{ tiles: typeof tiles; featured?: boolean }> = [];
const lead = tiles[0];
let offset = 0;
if (lead && tiles.length >= 3 && lead.ratio >= 1.2) {
  rows.push({ tiles: [{ ...lead, ratio: 2.35 }], featured: true });
  offset = 1;
}
while (offset < tiles.length) {
  const size = tiles.length - offset === 3 ? 3 : 2;
  rows.push({ tiles: tiles.slice(offset, offset + size) });
  offset += size;
}
---
{photos.length > 0 ? (
  <div data-gallery data-zoom-in={zh ? '放大照片' : 'Zoom in'} data-zoom-out={zh ? '缩小照片' : 'Zoom out'}>
    <div class="photo-grid">
      {rows.map(({ tiles: row, featured }, rowIndex) => {
        const total = row.reduce((sum, tile) => sum + tile.ratio, 0);
        return <div class:list={['photo-row', { 'featured-row': featured }]}
          style={`--columns:${row.map(({ ratio }) => `minmax(0,${ratio}fr)`).join(' ')}`}>
          {row.map(({ image, ratio, title, alt, location, date, caption }, index) => {
            const share = ratio / total;
            const sizes = `(max-width: 620px) calc(100vw - 2.5rem), (max-width: 1240px) ${Math.round(92 * share)}vw, ${Math.round(1152 * share)}px`;
            return <figure class="photo-item" style={`--photo-ratio:${ratio}`}>
              <a class="photo-trigger pressable" href={assetUrl(image.full)} aria-label={zh ? `查看大图：${title}` : `Enlarge ${title}`}>
                <ResponsivePhoto {image} {sizes} {alt} priority={rowIndex === 0 && index === 0} />
                <span class="photo-zoom-hint" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 4.75H4.75V9M15 4.75h4.25V9M4.75 15v4.25H9M19.25 15v4.25H15"/></svg></span>
              </a>
              <figcaption>
                <span class="photo-title">{title}</span>
                {(location || date) && <span class="photo-meta">{[location, date].filter(Boolean).join(' · ')}</span>}
                {caption && <span class="photo-caption">{caption}</span>}
              </figcaption>
            </figure>;
          })}
        </div>;
      })}
    </div>
    <dialog class="photo-dialog" aria-label={zh ? '摄影作品预览' : 'Photograph preview'}>
      <div class="viewer">
        <div class="viewer-header">
          {photos.length > 1 && <span class="photo-count" aria-live="polite"></span>}
          <div class="viewer-tools">
            <button type="button" class="viewer-button" data-photo-zoom aria-label={zh ? '放大照片' : 'Zoom in'} aria-pressed="false" disabled>
              <svg class="zoom-in-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.25"/><path d="m15.4 15.4 4.1 4.1M10.8 8v5.6M8 10.8h5.6"/></svg>
              <svg class="zoom-out-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.25"/><path d="m15.4 15.4 4.1 4.1M8 10.8h5.6"/></svg>
            </button>
            <button type="button" class="viewer-button photo-close" data-photo-close aria-label={zh ? '关闭' : 'Close'} autofocus>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6.5 6.5 11 11m0-11-11 11"/></svg>
            </button>
          </div>
        </div>
        <div class="viewer-stage">
          <img alt="" decoding="async" hidden />
          <p class="photo-error" hidden>{zh ? '图片暂时无法加载。' : 'This photo could not be loaded.'}</p>
        </div>
        <div class="viewer-footer">
          <div class="viewer-caption" aria-live="polite"></div>
          {photos.length > 1 && <div class="viewer-controls">
            <button type="button" class="viewer-button" data-photo-step="-1" aria-label={zh ? '上一张' : 'Previous photo'}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.75 5.5-6.5 6.5 6.5 6.5"/></svg>
            </button>
            <button type="button" class="viewer-button" data-photo-step="1" aria-label={zh ? '下一张' : 'Next photo'}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.25 5.5 6.5 6.5-6.5 6.5"/></svg>
            </button>
          </div>}
        </div>
      </div>
    </dialog>
  </div>
) : (
  <p class="empty-state">{zh ? '相册暂无作品。' : 'No photographs yet.'}</p>
)}
<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const dialog = gallery.querySelector('dialog')!;
    const image = dialog.querySelector('img')!;
    const stage = dialog.querySelector<HTMLElement>('.viewer-stage')!;
    const caption = dialog.querySelector('.viewer-caption')!;
    const error = dialog.querySelector<HTMLElement>('.photo-error')!;
    const count = dialog.querySelector('.photo-count');
    const zoom = dialog.querySelector<HTMLButtonElement>('[data-photo-zoom]')!;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const triggers = [...gallery.querySelectorAll<HTMLAnchorElement>('.photo-trigger')];
    let index = 0;
    let revision = 0;
    let upgradePhoto: ((scale: number) => void) | undefined;
    let opener: HTMLAnchorElement;
    let closing = false;
    let startX = 0;
    let startY = 0;
    image.draggable = false;

    async function loadForViewer(src: string) {
      const nextImage = new Image();
      nextImage.src = src;
      await nextImage.decode();
      return nextImage.src;
    }

    function setZoom(active: boolean) {
      stage.classList.toggle('is-zoomed', active);
      zoom.setAttribute('aria-pressed', String(active));
      zoom.setAttribute('aria-label', (active ? gallery.dataset.zoomOut : gallery.dataset.zoomIn) ?? '');
      zoom.textContent = active ? '−' : '+';
      if (active) {
        upgradePhoto?.(1.65);
        stage.scrollLeft = (stage.scrollWidth - stage.clientWidth) / 2;
        stage.scrollTop = (stage.scrollHeight - stage.clientHeight) / 2;
      } else {
        stage.scrollLeft = 0;
        stage.scrollTop = 0;
      }
    }

    function animateFromOpener() {
      if (motion.matches || !opener || image.hidden) return;
      const from = opener.getBoundingClientRect();
      const to = image.getBoundingClientRect();
      if (!from.width || !from.height || !to.width || !to.height) return;
      image.animate([
        {
          transformOrigin: 'top left',
          transform: `translate(${from.left - to.left}px, ${from.top - to.top}px) scale(${from.width / to.width}, ${from.height / to.height})`,
          opacity: .7,
        },
        { transformOrigin: 'top left', transform: 'none', opacity: 1 },
      ], { duration: 480, easing: 'cubic-bezier(.22,1,.36,1)' });
    }

    async function closeWithMotion() {
      if (!dialog.open || closing) return;
      closing = true;
      setZoom(false);
      if (!motion.matches && opener && !image.hidden) {
        const from = image.getBoundingClientRect();
        const to = opener.getBoundingClientRect();
        if (from.width && from.height && to.width && to.height) {
          const animation = image.animate([
            { transformOrigin: 'top left', transform: 'none', opacity: 1 },
            {
              transformOrigin: 'top left',
              transform: `translate(${to.left - from.left}px, ${to.top - from.top}px) scale(${to.width / from.width}, ${to.height / from.height})`,
              opacity: .7,
            },
          ], { duration: 300, easing: 'cubic-bezier(.32,0,.67,0)' });
          try { await animation.finished; } catch {}
        }
      }
      if (dialog.open) dialog.close();
    }

    const show = (next: number) => {
      const opening = !dialog.open;
      const direction = dialog.open ? Math.sign(next - index) : 0;
      index = (next + triggers.length) % triggers.length;
      const trigger = triggers[index];
      if (!trigger) return;
      revision += 1;
      const thumb = trigger.querySelector('img')!;
      caption.replaceChildren(...[...trigger.closest('figure')!.querySelector('figcaption')!.children].map((item) => item.cloneNode(true)));
      if (count) count.textContent = `${index + 1} / ${triggers.length}`;
      image.alt = thumb.alt;
      error.hidden = true;
      setZoom(false);
      image.getAnimations().forEach((animation) => animation.cancel());
      const preview = thumb.complete && thumb.naturalWidth ? thumb.currentSrc : '';
      zoom.disabled = !preview;
      image.hidden = !preview;
      if (preview) image.src = preview;
      else image.removeAttribute('src');

      if (opening) {
        document.documentElement.classList.add('photo-view-open');
        document.body.classList.add('photo-view-open');
        dialog.showModal();
      }
      const ratio = Number(thumb.getAttribute('width')) / Number(thumb.getAttribute('height'));
      const hasRatio = Number.isFinite(ratio) && ratio > 0;
      image.style.setProperty('--viewer-photo-width', hasRatio ? `min(92vw, calc(84dvh * ${ratio}))` : '92vw');
      const target = Math.min(innerWidth * .92, innerHeight * .84 * (hasRatio ? ratio : 1.5)) * Math.min(devicePixelRatio, 2);
      const format = preview.endsWith('.avif') ? 'avif' : 'webp';
      const srcset = trigger.querySelector<HTMLSourceElement>(`source[type="image/${format}"]`)?.srcset;
      const candidates = srcset?.split(',').map((value) => value.trim().split(' ')) ?? [];

      const animate = () => {
        if (!direction || motion.matches) return;
        image.animate(
          [{ opacity: .65, translate: `${direction * 8}px 0` }, { opacity: 1, translate: '0 0' }],
          { duration: 300, easing: 'cubic-bezier(.22,1,.36,1)' },
        );
      };
      if (preview && opening) requestAnimationFrame(animateFromOpener);
      else if (preview) animate();
      upgradePhoto = (scale) => {
        const request = ++revision;
        const source = candidates.find(([, width]) => Number.parseInt(width ?? '', 10) >= target * scale) ?? candidates.at(-1);
        const preferred = source?.[0] ? new URL(source[0], location.href).href : trigger.href;
        if (preferred === image.src) return;
        void loadForViewer(preferred).catch((failure) => {
          if (request !== revision || !dialog.open) return undefined;
          if (preferred === trigger.href) throw failure;
          return loadForViewer(trigger.href);
        }).then((src) => {
          if (!src || request !== revision || !dialog.open) return;
          const firstPaint = image.hidden;
          image.src = src;
          image.hidden = false;
          zoom.disabled = false;
          if (firstPaint && opening) requestAnimationFrame(animateFromOpener);
          else if (firstPaint) animate();
        }).catch(() => {
          if (request === revision && dialog.open && image.hidden) error.hidden = false;
        });
      };
      upgradePhoto(1);
    };
    for (const [i, trigger] of triggers.entries()) {
      trigger.addEventListener('click', (event) => {
        if (!dialog.showModal || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        opener = trigger;
        show(i);
      });
    }
    dialog.querySelector('[data-photo-close]')!.addEventListener('click', () => void closeWithMotion());
    const toggleZoom = () => { if (!zoom.disabled) setZoom(!stage.classList.contains('is-zoomed')); };
    zoom.addEventListener('click', toggleZoom);
    image.addEventListener('click', toggleZoom);
    dialog.addEventListener('close', () => {
      revision += 1;
      closing = false;
      document.documentElement.classList.remove('photo-view-open');
      document.body.classList.remove('photo-view-open');
      opener?.focus();
    });
    dialog.addEventListener('cancel', (event) => { event.preventDefault(); void closeWithMotion(); });
    dialog.addEventListener('click', (event) => { if (event.target === dialog) void closeWithMotion(); });
    for (const button of dialog.querySelectorAll<HTMLButtonElement>('[data-photo-step]')) {
      button.addEventListener('click', () => show(index + Number(button.dataset.photoStep)));
    }
    if (triggers.length < 2) continue;
    dialog.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      show(index + (event.key === 'ArrowLeft' ? -1 : 1));
    });
    stage.addEventListener('touchstart', (event) => {
      const touch = event.touches.item(0);
      if (!touch) return;
      startX = touch.clientX;
      startY = touch.clientY;
    }, { passive: true });
    stage.addEventListener('touchend', (event) => {
      if (stage.classList.contains('is-zoomed')) return;
      const touch = event.changedTouches.item(0);
      if (!touch) return;
      const dx = touch.clientX - startX;
      const dy = touch.clientY - startY;
      if (Math.abs(dx) > 46 && Math.abs(dx) > Math.abs(dy) * 1.4) show(index + (dx < 0 ? 1 : -1));
    }, { passive: true });
  }
</script>
<style>
  .photo-grid{display:grid;gap:clamp(2.4rem,5vw,4.25rem)}
  .photo-row{display:grid;grid-template-columns:var(--columns);gap:clamp(1rem,2.2vw,1.8rem);align-items:start}
  .photo-item{min-width:0;margin:0}
  .photo-trigger{position:relative;display:block;overflow:hidden;border-radius:1rem;background:var(--color-surface);cursor:zoom-in;isolation:isolate}
  .photo-trigger :global(img){width:100%;height:auto;aspect-ratio:var(--photo-ratio);object-fit:cover;transition:transform .8s cubic-bezier(.2,.7,.1,1),filter .55s ease}
  .featured-row .photo-trigger :global(img){object-position:center 61%}
  .photo-zoom-hint{position:absolute;right:.8rem;bottom:.8rem;display:grid;width:2.65rem;height:2.65rem;place-items:center;border:1px solid rgb(255 255 255 / .5);border-radius:50%;background:rgb(20 22 24 / .26);color:white;opacity:0;scale:.9;transition:opacity .25s ease,scale .35s var(--ease-out),background-color .25s ease;-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}
  .photo-zoom-hint svg{width:1.15rem;height:1.15rem;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
  @media(hover:hover){.photo-trigger:hover :global(img){transform:scale(1.035)}.photo-trigger:hover .photo-zoom-hint,.photo-trigger:focus-visible .photo-zoom-hint{opacity:1;scale:1}}
  figcaption,.viewer-caption{display:flex;flex-direction:column;gap:.18rem;margin-top:.72rem}
  .photo-title{font-size:var(--text-base);font-weight:590;letter-spacing:-.012em}
  .photo-meta,.photo-caption{color:var(--color-muted);font-size:var(--text-sm);line-height:1.55}
  .photo-dialog{position:fixed;inset:0;width:100vw;height:100%;height:100dvh;max-width:none;max-height:none;margin:0;padding:0;overflow:hidden;border:0;border-radius:0;background:rgb(15 16 18 / .96);color:#f5f5f7;overscroll-behavior:contain}
  :global(html.photo-view-open),:global(body.photo-view-open){overflow:hidden;scrollbar-width:none}
  :global(html.photo-view-open::-webkit-scrollbar),:global(body.photo-view-open::-webkit-scrollbar){display:none}
  .photo-dialog::backdrop{background:rgb(9 10 12 / .88);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);opacity:1;transition:opacity .34s ease,display .34s allow-discrete,overlay .34s allow-discrete}
  @starting-style{.photo-dialog[open]::backdrop{opacity:0}}
  .viewer{position:relative;width:100%;height:100%;min-height:0;isolation:isolate}
  .viewer-header{position:absolute;z-index:3;top:0;left:0;right:0;display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:max(1rem,env(safe-area-inset-top)) clamp(1rem,4vw,3.5rem) .75rem;color:#f5f5f7}
  .photo-count{color:rgb(255 255 255 / .78);font-size:.8rem;font-variant-numeric:tabular-nums;letter-spacing:.035em}
  .viewer-tools,.viewer-controls{display:flex;align-items:center;gap:.48rem}
  .viewer-button{flex:none;display:grid;width:2.9rem;height:2.9rem;place-items:center;padding:0;border:1px solid rgb(255 255 255 / .16);border-radius:50%;background:rgb(255 255 255 / .085);color:#fff;cursor:pointer;transition:background-color .2s ease,border-color .2s ease,scale .26s var(--ease-out),opacity .2s ease;-webkit-backdrop-filter:blur(20px) saturate(145%);backdrop-filter:blur(20px) saturate(145%)}
  .viewer-button svg{width:1.25rem;height:1.25rem;fill:none;stroke:currentColor;stroke-width:1.55;stroke-linecap:round;stroke-linejoin:round}
  .viewer-button:hover:not(:disabled){background:rgb(255 255 255 / .17);border-color:rgb(255 255 255 / .3)}
  .viewer-button:active:not(:disabled){scale:.92}
  .viewer-button:disabled{opacity:.42;cursor:default}
  .viewer-button:focus-visible{outline:2px solid #fff;outline-offset:2px}
  [data-photo-zoom][aria-pressed="true"] .zoom-in-icon{display:none}
  [data-photo-zoom][aria-pressed="false"] .zoom-out-icon{display:none}
  .viewer-stage{position:absolute;inset:4.75rem 0 7.4rem;display:grid;place-items:center;min-width:0;min-height:0;overflow:auto;overscroll-behavior:contain;scrollbar-width:none;touch-action:pan-y}
  .viewer-stage::-webkit-scrollbar{display:none}
  .viewer-stage img{display:block;width:var(--viewer-photo-width,92vw);max-width:92vw;max-height:84dvh;object-fit:contain;cursor:zoom-in;user-select:none;-webkit-user-drag:none}
  .viewer-stage.is-zoomed{place-items:start;touch-action:pan-x pan-y}
  .viewer-stage.is-zoomed img{width:calc(var(--viewer-photo-width,92vw) * 1.65);max-width:none;max-height:none;cursor:zoom-out}
  .viewer-stage img[hidden]{display:none}
  .photo-error{color:rgb(255 255 255 / .75)}
  .viewer-footer{position:absolute;z-index:3;right:0;bottom:0;left:0;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:1rem;padding:1rem clamp(1rem,4vw,3.5rem) max(1.1rem,env(safe-area-inset-bottom));background:linear-gradient(0deg,rgb(12 13 15 / .38),transparent 100%);pointer-events:none}
  .viewer-caption{min-width:0;margin:0;color:#fff;pointer-events:auto}
  .viewer-caption :global(.photo-title){font-size:var(--text-base);font-weight:560}
  .viewer-caption :global(.photo-meta),.viewer-caption :global(.photo-caption){color:rgb(255 255 255 / .68)}
  .viewer-controls{pointer-events:auto}
  @media(max-width:620px){
    .photo-grid{gap:2.5rem}.photo-row{grid-template-columns:minmax(0,1fr);gap:2rem}
    .photo-trigger{border-radius:.8rem}.photo-trigger :global(img){aspect-ratio:clamp(.8,var(--photo-ratio),1.6)}
    .photo-dialog{background:rgb(11 12 14 / .98)}.viewer-header{padding-inline:1rem}
    .viewer-stage{inset:4.3rem 0 7rem}.viewer-stage img{max-width:94vw;max-height:80dvh}
    .viewer-footer{grid-template-columns:minmax(0,1fr);align-items:start;gap:.85rem;padding-inline:1rem}
    .viewer-caption{max-width:100%;padding-right:1rem}.viewer-controls{justify-self:end;gap:.4rem}
    .viewer-button{width:2.75rem;height:2.75rem}
  }
  @media(prefers-reduced-transparency:reduce){.photo-dialog::backdrop{backdrop-filter:none;-webkit-backdrop-filter:none}.viewer-button{background:rgb(32 34 37 / .96);backdrop-filter:none;-webkit-backdrop-filter:none}}
</style>
