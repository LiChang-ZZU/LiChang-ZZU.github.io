---
import type { Locale } from '@/types';
import { assetUrl } from '@/utils/urls';
import { getPhotos, photoImage, photoText } from '@/utils/photos';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const photos = await getPhotos();
const formatDate = new Intl.DateTimeFormat(zh ? 'zh-CN' : 'en-GB', {
  year: 'numeric', month: 'long', timeZone: 'UTC',
});
---
{photos.length > 0 ? (
  <div data-gallery>
    <div class:list={['photo-grid', { 'single-photo': photos.length === 1 }]}>
      {photos.map(({ data }, index) => {
        const image = photoImage(data.image, data.maxSize, data.compress);
        const copy = photoText(data, locale);
        const date = data.date ? formatDate.format(data.date) : '';
        return <figure class="photo-item" data-reveal="fade-up">
          <a class="photo-trigger pressable" href={assetUrl(image.full)} aria-label={zh ? `查看大图：${copy.title}` : `Enlarge ${copy.title}`}>
            <img src={assetUrl(image.src)} srcset={image.srcset}
              sizes={photos.length === 1 ? '(max-width: 900px) 95vw, 900px' : '(max-width: 580px) 93vw, (max-width: 920px) 45vw, 360px'}
              alt={copy.alt} width={image.width || undefined} height={image.height || undefined}
              loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
          </a>
          <figcaption>
            <span class="photo-title">{copy.title}</span>
            {(copy.location || date) && <span class="photo-meta">{[copy.location, date].filter(Boolean).join(' · ')}</span>}
            {copy.caption && <span class="photo-caption">{copy.caption}</span>}
          </figcaption>
        </figure>;
      })}
    </div>
    <dialog class="photo-dialog glass-surface motion-dialog" aria-label={zh ? '摄影作品预览' : 'Photograph preview'}>
      <div class="viewer">
        <div class="viewer-header">
          {photos.length > 1 && <span class="photo-count" aria-live="polite"></span>}
          <button type="button" class="photo-close icon-button" data-photo-close aria-label={zh ? '关闭' : 'Close'} autofocus>×</button>
        </div>
        <div class="viewer-stage">
          <img alt="" />
          <p class="photo-error" hidden>{zh ? '图片暂时无法加载。' : 'This photo could not be loaded.'}</p>
        </div>
        <div class="viewer-footer">
          <div class="viewer-caption" aria-live="polite"></div>
          {photos.length > 1 && <div class="viewer-controls">
            <button type="button" class="icon-button" data-photo-step="-1" aria-label={zh ? '上一张' : 'Previous photo'}>‹</button>
            <button type="button" class="icon-button" data-photo-step="1" aria-label={zh ? '下一张' : 'Next photo'}>›</button>
          </div>}
        </div>
      </div>
    </dialog>
  </div>
) : (
  <p class="empty-state">{zh ? '相册暂无作品。' : 'No photographs yet.'}</p>
)}
<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const dialog = gallery.querySelector('dialog')!;
    const image = dialog.querySelector('img')!;
    const stage = dialog.querySelector<HTMLElement>('.viewer-stage')!;
    const caption = dialog.querySelector('.viewer-caption')!;
    const error = dialog.querySelector<HTMLElement>('.photo-error')!;
    const count = dialog.querySelector('.photo-count');
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const triggers = [...gallery.querySelectorAll<HTMLAnchorElement>('.photo-trigger')];
    let index = 0;
    let opener: HTMLAnchorElement;
    let startX = 0;
    let startY = 0;
    image.draggable = false;
    const show = (next: number) => {
      const direction = dialog.open ? Math.sign(next - index) : 0;
      index = (next + triggers.length) % triggers.length;
      const trigger = triggers[index];
      if (!trigger) return;
      caption.replaceChildren(...[...trigger.closest('figure')!.querySelector('figcaption')!.children].map((item) => item.cloneNode(true)));
      if (count) count.textContent = `${index + 1} / ${triggers.length}`;
      image.alt = trigger.querySelector('img')!.alt;
      error.hidden = true;
      image.hidden = false;
      image.src = trigger.href;
      if (motion.matches || !direction) return;
      const src = image.src;
      void image.decode().then(() => {
        if (image.src !== src || !dialog.open || motion.matches) return;
        image.getAnimations().forEach((animation) => animation.cancel());
        image.animate(
          [{ opacity: .5, translate: `${direction * 9}px 0` }, { opacity: 1, translate: '0 0' }],
          { duration: 300, easing: 'cubic-bezier(.22,1,.36,1)' },
        );
      }, () => {});
    };
    for (const [i, trigger] of triggers.entries()) {
      trigger.addEventListener('click', (event) => {
        if (!dialog.showModal || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        opener = trigger;
        show(i);
        dialog.showModal();
      });
    }
    image.addEventListener('error', () => { image.hidden = true; error.hidden = false; });
    dialog.querySelector('[data-photo-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => opener?.focus());
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    for (const button of dialog.querySelectorAll<HTMLButtonElement>('[data-photo-step]')) {
      button.addEventListener('click', () => show(index + Number(button.dataset.photoStep)));
    }
    if (triggers.length < 2) continue;
    dialog.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      show(index + (event.key === 'ArrowLeft' ? -1 : 1));
    });
    stage.addEventListener('touchstart', (event) => {
      const touch = event.touches.item(0);
      if (!touch) return;
      startX = touch.clientX;
      startY = touch.clientY;
    }, { passive: true });
    stage.addEventListener('touchend', (event) => {
      const touch = event.changedTouches.item(0);
      if (!touch) return;
      const dx = touch.clientX - startX;
      const dy = touch.clientY - startY;
      if (Math.abs(dx) > 46 && Math.abs(dx) > Math.abs(dy) * 1.4) show(index + (dx < 0 ? 1 : -1));
    }, { passive: true });
  }
</script>
<style>
  .photo-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(1rem,2.5vw,1.8rem)}
  .photo-grid.single-photo{grid-template-columns:minmax(0,56rem)}
  .photo-item{min-width:0;margin:0}
  .photo-trigger{position:relative;display:block;overflow:hidden;border-radius:var(--radius-lg);background:var(--color-surface);cursor:zoom-in}
  .photo-trigger img{width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;transition:transform .6s var(--ease-out)}
  .single-photo img{aspect-ratio:auto;max-height:68vh;object-fit:contain;background:var(--color-surface)}
  @media(hover:hover){.photo-trigger:hover img{transform:scale(1.025)}}
  figcaption,.viewer-caption{display:flex;flex-direction:column;gap:.2rem;margin-top:.8rem}
  .photo-title{font-size:var(--text-base);font-weight:650}
  .photo-meta,.photo-caption{color:var(--color-muted);font-size:var(--text-sm)}
  .photo-dialog{--color-surface:#121718;--glass-fill:rgb(20 26 27 / .84);--glass-sheen:rgb(255 255 255 / .095);--glass-rim:rgb(255 255 255 / .18);width:min(94vw,76rem);max-height:94dvh;padding:0;overflow:auto;overscroll-behavior:contain;border-radius:var(--radius-lg);color:#fff}
  .photo-dialog::backdrop{background:rgb(8 14 16 / .82);backdrop-filter:blur(var(--glass-blur))}
  .viewer-header,.viewer-footer{display:flex;justify-content:space-between;align-items:center;gap:.65rem;padding:.65rem 1rem}
  .viewer-header{justify-content:flex-end}
  .photo-count{margin-right:auto;color:#d1dcdf;font-size:var(--text-sm);font-variant-numeric:tabular-nums}
  .viewer-stage{display:grid;min-height:min(33vh,15rem);place-items:center;background:#080a0b;touch-action:pan-y}
  .viewer-stage img{width:auto;max-width:100%;max-height:70dvh;object-fit:contain}
  .viewer-stage img[hidden]{display:none}
  .viewer-caption{margin:0;color:#fff}
  .viewer-caption :global(.photo-meta),.viewer-caption :global(.photo-caption){color:#d1dcdf}
  .viewer-controls{display:flex;gap:.5rem}
  .viewer button{flex:none;display:grid;place-items:center;width:2.75rem;height:2.75rem;padding:0;border:1px solid rgb(255 255 255 / .2);border-radius:50%;background:#222a2d;color:#fff;font-size:1.6rem;line-height:1;cursor:pointer}
  .viewer button:hover{background:#37454a}
  @media(max-width:920px){.photo-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:580px){.photo-grid{grid-template-columns:minmax(0,1fr)}}
</style>
