---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import type { Locale } from '@/types';
import { assetUrl } from '@/utils/urls';
interface Props { locale: Locale }
const { locale } = Astro.props;
type Derivative = { src: string; width: number; height: number };
let manifest: Record<string, Derivative> = {};
try { manifest = JSON.parse(fs.readFileSync(path.join(process.cwd(), '.photo-manifest.json'), 'utf8')); } catch {}
const imageOf = (image: string) => manifest[image] ?? { src: image, width: 0, height: 0 };
const photos = (await getCollection('photos', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (date: Date) => new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-GB', { year: 'numeric', month: '2-digit' }).format(date).replace(/\//g, '.');
---
{photos.length ? (
  <>
    <div class="photo-grid">
      {photos.map((photo) => (
        <figure class="photo-item">
          <button type="button" class="photo-trigger" data-full={assetUrl(imageOf(photo.data.image).src)} data-title={photo.data.title} aria-label={photo.data.title}>
            <img src={assetUrl(imageOf(photo.data.image).src)} alt={photo.data.title} width={imageOf(photo.data.image).width || undefined} height={imageOf(photo.data.image).height || undefined} loading="lazy" decoding="async" />
          </button>
          <figcaption>
            <span class="photo-title">{photo.data.title}</span>
            <span class="photo-meta">{[photo.data.location, fmt(photo.data.date)].filter(Boolean).join(' · ')}</span>
            {photo.data.caption && <span class="photo-caption">{photo.data.caption}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
    <dialog class="photo-dialog" aria-label={locale === 'zh' ? '作品预览' : 'Photo preview'}><button type="button" class="photo-close" aria-label={locale === 'zh' ? '关闭' : 'Close'}>×</button><img alt="" /><p></p></dialog>
    <script>
      const setupLightbox = () => {
        const dialog = document.querySelector<HTMLDialogElement>('.photo-dialog');
        if (!dialog || dialog.dataset.ready) return;
        dialog.dataset.ready = 'true';
        const img = dialog.querySelector('img')!;
        const caption = dialog.querySelector('p')!;
        document.querySelectorAll<HTMLButtonElement>('.photo-trigger').forEach((trigger) => {
          trigger.addEventListener('click', () => {
            img.src = trigger.dataset.full ?? '';
            img.alt = trigger.dataset.title ?? '';
            caption.textContent = trigger.dataset.title ?? '';
            dialog.showModal();
          });
        });
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog || (event.target as HTMLElement).closest('.photo-close')) dialog.close();
        });
      };
      setupLightbox(); document.addEventListener('astro:after-swap', setupLightbox);
    </script>
  </>
) : (
  <div class="gallery-empty">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5A2.5 2.5 0 0 1 5.5 6h1.2l1.1-1.8A1.5 1.5 0 0 1 9.1 3.5h5.8a1.5 1.5 0 0 1 1.3.7L17.3 6h1.2A2.5 2.5 0 0 1 21 8.5v9A2.5 2.5 0 0 1 18.5 20h-13A2.5 2.5 0 0 1 3 17.5v-9Z"/><circle cx="12" cy="13" r="3.6"/></svg>
    <p>{locale === 'zh' ? '摄影作品整理中，敬请期待。' : 'Photographs are being curated — coming soon.'}</p>
  </div>
)}
<style>
  .photo-grid { columns: 3; column-gap: 1.4rem; }
  .photo-item { margin: 0 0 1.4rem; break-inside: avoid; }
  .photo-trigger { display: block; width: 100%; padding: 0; border: 0; border-radius: var(--radius-md); overflow: hidden; background: var(--color-surface); cursor: zoom-in; }
  .photo-trigger img { display: block; width: 100%; height: auto; transition: transform .5s cubic-bezier(.22,1,.36,1), opacity var(--transition-base); }
  .photo-trigger:hover img { transform: scale(1.025); opacity: .95; }
  .photo-item figcaption { display: flex; flex-direction: column; gap: .18rem; margin-top: .7rem; }
  .photo-title { font-size: var(--text-sm); font-weight: 600; }
  .photo-meta { color: var(--color-faint); font-size: var(--text-xs); font-variant-numeric: tabular-nums; }
  .photo-caption { color: var(--color-muted); font-size: .8rem; line-height: 1.5; }
  .photo-dialog { max-width: min(92vw, 68rem); max-height: 90vh; padding: 0; border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); overflow: hidden; }
  .photo-dialog::backdrop { background: rgb(0 0 0 / .72); backdrop-filter: blur(6px); }
  .photo-dialog img { display: block; max-width: 100%; max-height: 80vh; margin: 0 auto; object-fit: contain; }
  .photo-dialog p { margin: 0; padding: .8rem 1rem 1rem; color: var(--color-muted); font-size: var(--text-sm); text-align: center; }
  .photo-close { position: absolute; z-index: 1; top: .6rem; right: .6rem; width: 2.2rem; height: 2.2rem; border: 0; border-radius: 50%; background: rgb(0 0 0 / .55); color: #fff; font-size: 1.1rem; line-height: 1; cursor: pointer; }
  .gallery-empty { display: flex; flex-direction: column; align-items: center; gap: .8rem; padding: clamp(3rem, 10vw, 6rem) 1rem; border: 1px dashed var(--color-line); border-radius: var(--radius-md); color: var(--color-faint); text-align: center; }
  .gallery-empty p { margin: 0; font-size: var(--text-sm); }
  @media (max-width: 900px) { .photo-grid { columns: 2; } }
  @media (max-width: 560px) { .photo-grid { columns: 1; } }
</style>
