---
import type { Locale } from '@/types';
import { assetUrl } from '@/utils/urls';
import { getPhotos, photoImage, photoText } from '@/utils/photos';
import ResponsivePhoto from './ResponsivePhoto.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const photos = await getPhotos();
const formatDate = new Intl.DateTimeFormat(zh ? 'zh-CN' : 'en-GB', {
  year: 'numeric', month: 'long', timeZone: 'UTC',
});
const tiles = photos.map(({ data }) => {
  const image = photoImage(data.image, data.maxSize, data.compress);
  const ratio = image.height ? image.width / image.height : 1.33;
  return {
    image,
    ratio: Math.max(.66, Math.min(1.85, ratio)),
    date: data.date ? formatDate.format(data.date) : '',
    ...photoText(data, locale),
  };
});
const rows: Array<{ tiles: typeof tiles; featured?: boolean }> = [];
const lead = tiles[0];
let offset = 0;
if (lead && tiles.length >= 3 && lead.ratio >= 1.2) {
  rows.push({ tiles: [{ ...lead, ratio: 2.35 }], featured: true });
  offset = 1;
}
while (offset < tiles.length) {
  const size = tiles.length - offset === 3 ? 3 : 2;
  rows.push({ tiles: tiles.slice(offset, offset + size) });
  offset += size;
}
---
{photos.length > 0 ? (
  <div data-gallery data-zoom-in={zh ? '放大照片' : 'Zoom in'} data-zoom-out={zh ? '缩小照片' : 'Zoom out'}>
    <div class="photo-grid">
      {rows.map(({ tiles: row, featured }, rowIndex) => {
        const total = row.reduce((sum, tile) => sum + tile.ratio, 0);
        return <div class:list={['photo-row', { 'featured-row': featured }]}
          style={`--columns:${row.map(({ ratio }) => `minmax(0,${ratio}fr)`).join(' ')}`}>
          {row.map(({ image, ratio, title, alt, location, date, caption }, index) => {
            const share = ratio / total;
            const sizes = `(max-width: 620px) calc(100vw - 2.5rem), (max-width: 1240px) ${Math.round(92 * share)}vw, ${Math.round(1152 * share)}px`;
            return <figure class="photo-item" style={`--photo-ratio:${ratio}`}>
              <a class="photo-trigger pressable" href={assetUrl(image.full)} aria-label={zh ? `查看大图：${title}` : `Enlarge ${title}`}>
                <ResponsivePhoto {image} {sizes} {alt} priority={rowIndex === 0 && index === 0} />
              </a>
              <figcaption>
                <span class="photo-title">{title}</span>
                {(location || date) && <span class="photo-meta">{[location, date].filter(Boolean).join(' · ')}</span>}
                {caption && <span class="photo-caption">{caption}</span>}
              </figcaption>
            </figure>;
          })}
        </div>;
      })}
    </div>
    <dialog class="photo-dialog glass-surface motion-dialog" aria-label={zh ? '摄影作品预览' : 'Photograph preview'}>
      <div class="viewer">
        <div class="viewer-header">
          {photos.length > 1 && <span class="photo-count" aria-live="polite"></span>}
          <button type="button" class="icon-button" data-photo-zoom aria-label={zh ? '放大照片' : 'Zoom in'} aria-pressed="false" disabled>+</button>
          <button type="button" class="photo-close icon-button" data-photo-close aria-label={zh ? '关闭' : 'Close'} autofocus>×</button>
        </div>
        <div class="viewer-stage">
          <img alt="" decoding="async" hidden />
          <p class="photo-error" hidden>{zh ? '图片暂时无法加载。' : 'This photo could not be loaded.'}</p>
        </div>
        <div class="viewer-footer">
          <div class="viewer-caption" aria-live="polite"></div>
          {photos.length > 1 && <div class="viewer-controls">
            <button type="button" class="icon-button" data-photo-step="-1" aria-label={zh ? '上一张' : 'Previous photo'}>‹</button>
            <button type="button" class="icon-button" data-photo-step="1" aria-label={zh ? '下一张' : 'Next photo'}>›</button>
          </div>}
        </div>
      </div>
    </dialog>
  </div>
) : (
  <p class="empty-state">{zh ? '相册暂无作品。' : 'No photographs yet.'}</p>
)}
<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const dialog = gallery.querySelector('dialog')!;
    const image = dialog.querySelector('img')!;
    const stage = dialog.querySelector<HTMLElement>('.viewer-stage')!;
    const caption = dialog.querySelector('.viewer-caption')!;
    const error = dialog.querySelector<HTMLElement>('.photo-error')!;
    const count = dialog.querySelector('.photo-count');
    const zoom = dialog.querySelector<HTMLButtonElement>('[data-photo-zoom]')!;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const triggers = [...gallery.querySelectorAll<HTMLAnchorElement>('.photo-trigger')];
    let index = 0;
    let revision = 0;
    let upgradePhoto: ((scale: number) => void) | undefined;
    let opener: HTMLAnchorElement;
    let startX = 0;
    let startY = 0;
    image.draggable = false;

    async function loadForViewer(src: string) {
      const nextImage = new Image();
      nextImage.src = src;
      await nextImage.decode();
      return nextImage.src;
    }

    function setZoom(active: boolean) {
      stage.classList.toggle('is-zoomed', active);
      zoom.setAttribute('aria-pressed', String(active));
      zoom.setAttribute('aria-label', (active ? gallery.dataset.zoomOut : gallery.dataset.zoomIn) ?? '');
      zoom.textContent = active ? '−' : '+';
      if (active) {
        upgradePhoto?.(1.65);
        stage.scrollLeft = (stage.scrollWidth - stage.clientWidth) / 2;
        stage.scrollTop = (stage.scrollHeight - stage.clientHeight) / 2;
      } else {
        stage.scrollLeft = 0;
        stage.scrollTop = 0;
      }
    }

    const show = (next: number) => {
      const direction = dialog.open ? Math.sign(next - index) : 0;
      index = (next + triggers.length) % triggers.length;
      const trigger = triggers[index];
      if (!trigger) return;
      revision += 1;
      const thumb = trigger.querySelector('img')!;
      caption.replaceChildren(...[...trigger.closest('figure')!.querySelector('figcaption')!.children].map((item) => item.cloneNode(true)));
      if (count) count.textContent = `${index + 1} / ${triggers.length}`;
      image.alt = thumb.alt;
      error.hidden = true;
      setZoom(false);
      image.getAnimations().forEach((animation) => animation.cancel());
      const preview = thumb.complete && thumb.naturalWidth ? thumb.currentSrc : '';
      zoom.disabled = !preview;
      image.hidden = !preview;
      if (preview) image.src = preview;
      else image.removeAttribute('src');

      if (!dialog.open) dialog.showModal();
      const ratio = Number(thumb.getAttribute('width')) / Number(thumb.getAttribute('height'));
      const hasRatio = Number.isFinite(ratio) && ratio > 0;
      image.style.setProperty('--viewer-photo-width', hasRatio ? `min(100%, calc(70dvh * ${ratio}))` : '100%');
      const target = Math.min(dialog.clientWidth, innerHeight * .7 * (hasRatio ? ratio : 1.5)) * Math.min(devicePixelRatio, 2);
      const format = preview.endsWith('.avif') ? 'avif' : 'webp';
      const srcset = trigger.querySelector<HTMLSourceElement>(`source[type="image/${format}"]`)?.srcset;
      const candidates = srcset?.split(',').map((value) => value.trim().split(' ')) ?? [];

      const animate = () => {
        if (!direction || motion.matches) return;
        image.animate(
          [{ opacity: .65, translate: `${direction * 8}px 0` }, { opacity: 1, translate: '0 0' }],
          { duration: 300, easing: 'cubic-bezier(.22,1,.36,1)' },
        );
      };
      if (preview) animate();
      upgradePhoto = (scale) => {
        const request = ++revision;
        const source = candidates.find(([, width]) => Number.parseInt(width ?? '', 10) >= target * scale) ?? candidates.at(-1);
        const preferred = source?.[0] ? new URL(source[0], location.href).href : trigger.href;
        if (preferred === image.src) return;
        void loadForViewer(preferred).catch((failure) => {
          if (request !== revision || !dialog.open) return undefined;
          if (preferred === trigger.href) throw failure;
          return loadForViewer(trigger.href);
        }).then((src) => {
          if (!src || request !== revision || !dialog.open) return;
          const firstPaint = image.hidden;
          image.src = src;
          image.hidden = false;
          zoom.disabled = false;
          if (firstPaint) animate();
        }).catch(() => {
          if (request === revision && dialog.open && image.hidden) error.hidden = false;
        });
      };
      upgradePhoto(1);
    };
    for (const [i, trigger] of triggers.entries()) {
      trigger.addEventListener('click', (event) => {
        if (!dialog.showModal || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        opener = trigger;
        show(i);
      });
    }
    dialog.querySelector('[data-photo-close]')!.addEventListener('click', () => dialog.close());
    const toggleZoom = () => { if (!zoom.disabled) setZoom(!stage.classList.contains('is-zoomed')); };
    zoom.addEventListener('click', toggleZoom);
    image.addEventListener('click', toggleZoom);
    dialog.addEventListener('close', () => { revision += 1; opener?.focus(); });
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    for (const button of dialog.querySelectorAll<HTMLButtonElement>('[data-photo-step]')) {
      button.addEventListener('click', () => show(index + Number(button.dataset.photoStep)));
    }
    if (triggers.length < 2) continue;
    dialog.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      show(index + (event.key === 'ArrowLeft' ? -1 : 1));
    });
    stage.addEventListener('touchstart', (event) => {
      const touch = event.touches.item(0);
      if (!touch) return;
      startX = touch.clientX;
      startY = touch.clientY;
    }, { passive: true });
    stage.addEventListener('touchend', (event) => {
      if (stage.classList.contains('is-zoomed')) return;
      const touch = event.changedTouches.item(0);
      if (!touch) return;
      const dx = touch.clientX - startX;
      const dy = touch.clientY - startY;
      if (Math.abs(dx) > 46 && Math.abs(dx) > Math.abs(dy) * 1.4) show(index + (dx < 0 ? 1 : -1));
    }, { passive: true });
  }
</script>
<style>
  .photo-grid{display:grid;gap:clamp(1.65rem,4vw,3.25rem)}
  .photo-row{display:grid;grid-template-columns:var(--columns);gap:clamp(1rem,2.5vw,1.75rem)}
  .photo-item{min-width:0;margin:0}
  .photo-trigger{position:relative;display:block;overflow:hidden;border-radius:var(--radius-lg);background:var(--color-surface);cursor:zoom-in}
  .photo-trigger :global(img){width:100%;height:auto;aspect-ratio:var(--photo-ratio);object-fit:cover;transition:transform .6s var(--ease-out)}
  .featured-row .photo-trigger :global(img){object-position:center 61%}
  @media(hover:hover){.photo-trigger:hover :global(img){transform:scale(1.025)}}
  figcaption,.viewer-caption{display:flex;flex-direction:column;gap:.2rem;margin-top:.8rem}
  .photo-title{font-size:var(--text-base);font-weight:650}
  .photo-meta,.photo-caption{color:var(--color-muted);font-size:var(--text-sm)}
  .photo-dialog{--color-surface:#121718;--glass-fill:rgb(20 26 27 / .84);--glass-sheen:rgb(255 255 255 / .095);--glass-rim:rgb(255 255 255 / .18);width:min(94vw,76rem);max-height:94dvh;padding:0;overflow:auto;overscroll-behavior:contain;border-radius:var(--radius-lg);color:#fff}
  .photo-dialog::backdrop{background:rgb(8 14 16 / .82);backdrop-filter:blur(var(--glass-blur))}
  .viewer-header,.viewer-footer{display:flex;justify-content:space-between;align-items:center;gap:.65rem;padding:.65rem 1rem}
  .viewer-header{justify-content:flex-end}
  .photo-count{margin-right:auto;color:#d1dcdf;font-size:var(--text-sm);font-variant-numeric:tabular-nums}
  .viewer-stage{display:grid;min-height:min(33vh,15rem);place-items:center;background:#080a0b;touch-action:pan-y}
  .viewer-stage img{width:var(--viewer-photo-width,auto);max-width:100%;max-height:70dvh;object-fit:contain;cursor:zoom-in}
  .viewer-stage.is-zoomed{max-height:70dvh;overflow:auto;place-items:start;touch-action:auto}
  .viewer-stage.is-zoomed img{width:calc(var(--viewer-photo-width,100%) * 1.65);max-width:none;max-height:none;cursor:zoom-out}
  .viewer-stage img[hidden]{display:none}
  .viewer-caption{margin:0;color:#fff}
  .viewer-caption :global(.photo-meta),.viewer-caption :global(.photo-caption){color:#d1dcdf}
  .viewer-controls{display:flex;gap:.5rem}
  .viewer button{flex:none;display:grid;place-items:center;width:2.75rem;height:2.75rem;padding:0;border:1px solid rgb(255 255 255 / .2);border-radius:50%;background:#222a2d;color:#fff;font-size:1.6rem;line-height:1;cursor:pointer}
  .viewer button:hover{background:#37454a}
  .viewer button:disabled{opacity:.45;cursor:default}
  @media(max-width:620px){
    .photo-row{grid-template-columns:minmax(0,1fr);gap:1.65rem}
    .photo-trigger :global(img){aspect-ratio:clamp(.8,var(--photo-ratio),1.6)}
  }
</style>
