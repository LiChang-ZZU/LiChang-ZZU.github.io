---
import site from '@/data/site';
import type { Locale } from '@/types';
import { getLocalizedPath } from '@/utils/urls';
import SearchButton from './SearchButton.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props { locale: Locale; alternatePath?: string }
const { locale, alternatePath } = Astro.props;
const zh = locale === 'zh';
const links = site.navigation.map((item) => {
  const href = getLocalizedPath(locale, `/${item.key}/`);
  return { label: item[locale], href, current: Astro.url.pathname === href };
});
---
<header class="site-header" data-header data-pagefind-ignore>
  <div class="nav-bar glass-surface">
    <nav class="nav" aria-label={zh ? '主导航' : 'Primary navigation'}>
      <a class="brand nav-control" href={getLocalizedPath(locale)} aria-label={zh ? `${site.name} 首页` : `${site.nameEn} home`}>
        {zh ? site.name : site.nameEn}
      </a>
      <div class="desktop-links">
        {links.map(({ href, label, current }) => (
          <a class="nav-control" {href} aria-current={current ? 'page' : undefined}>
            {current && <span class="nav-active" aria-hidden="true"></span>}
            <span class="nav-label">{label}</span>
          </a>
        ))}
      </div>
      <div class="nav-tools">
        {site.features.search && <SearchButton {locale} />}
        <LanguageSwitcher {locale} {alternatePath} />
        <ThemeToggle {locale} />
        <button class="menu-toggle nav-control" type="button" aria-expanded="false" aria-controls="mobile-menu"
          aria-label={zh ? '打开菜单' : 'Open menu'} data-open-label={zh ? '打开菜单' : 'Open menu'}
          data-close-label={zh ? '关闭菜单' : 'Close menu'}><span></span><span></span></button>
      </div>
    </nav>
  </div>
  <div class="menu-scrim" aria-hidden="true"></div>
  <div id="mobile-menu" class="mobile-menu glass-surface" inert>
    {links.map(({ href, label, current }, index) => (
      <a class="nav-control" {href} style={`--i:${index}`} aria-current={current ? 'page' : undefined}>{label}</a>
    ))}
    <a class="nav-control" href={getLocalizedPath(locale, '/contact/')} style={`--i:${links.length}`}>{zh ? '联系' : 'Contact'}</a>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const button = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = header?.querySelector<HTMLElement>('.mobile-menu');
  if (header && button && menu) {
    const syncHeader = () => header.classList.toggle('is-scrolled', scrollY > 12);
    syncHeader();
    addEventListener('scroll', syncHeader, { passive: true });

    const setOpen = (active: boolean) => {
      header.classList.toggle('is-menu-open', active);
      button.setAttribute('aria-expanded', String(active));
      button.setAttribute('aria-label', (active ? button.dataset.closeLabel : button.dataset.openLabel) ?? '');
      menu.inert = !active;
      document.body.classList.toggle('menu-open', active);
      document.querySelectorAll<HTMLElement>('main, footer, .back-top').forEach((element) => { element.inert = active; });
    };

    button.addEventListener('click', () => setOpen(menu.inert));
    header.querySelector('.menu-scrim')?.addEventListener('click', () => { setOpen(false); button.focus(); });
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
    addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.inert) { setOpen(false); button.focus(); }
    });
    addEventListener('pageswap', () => {
      header.classList.add('is-leaving');
      setOpen(false);
    });
    addEventListener('pageshow', () => {
      header.classList.remove('is-leaving');
      setOpen(false);
    });
    matchMedia('(max-width: 760px)').addEventListener('change', () => setOpen(false));
  }
</script>
<style>
  .site-header{position:fixed;z-index:100;inset:0 0 auto;pointer-events:none}
  .nav-bar{--glass-fill:color-mix(in srgb,var(--color-surface) 56%,transparent);--glass-blur:20px;position:relative;z-index:2;width:min(calc(100% - 1.5rem),65rem);margin:.6rem auto 0;border:1px solid var(--glass-rim);border-radius:var(--radius-pill);background-image:linear-gradient(165deg,var(--glass-sheen),transparent 62%);box-shadow:inset 0 1px 0 var(--glass-rim),var(--glass-shadow);pointer-events:auto;transition:background-color .25s ease,border-color .25s ease,box-shadow .25s ease}
  .site-header.is-scrolled .nav-bar{--glass-fill:color-mix(in srgb,var(--color-surface) 76%,transparent);border-color:color-mix(in srgb,var(--glass-rim) 60%,var(--color-line));box-shadow:inset 0 1px 0 var(--glass-rim),0 14px 40px -16px rgb(10 16 24 / .45)}
  .nav,.mobile-menu{width:min(calc(100% - 2rem),65rem);margin-inline:auto}
  .nav{--control-fill:color-mix(in srgb,var(--color-text) 7%,transparent);position:relative;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:.45rem;width:100%;height:var(--nav-height);padding-inline:clamp(.55rem,1.4vw,.95rem)}
  .brand{justify-self:start;padding-inline:.5rem;font-size:.94rem;font-weight:680;letter-spacing:-.02em;white-space:nowrap}
  .desktop-links,.nav-tools{display:flex;align-items:center;gap:.15rem}
  .desktop-links a{position:relative;padding-inline:clamp(.65rem,1.3vw,1.1rem);color:color-mix(in srgb,var(--color-text) 78%,var(--color-muted));font-size:.9rem;white-space:nowrap}
  .desktop-links a[aria-current="page"]{color:var(--color-text);font-weight:650}
  .nav-active{position:absolute;inset:auto 28% 1px;height:1.5px;border-radius:4px;background:var(--color-accent)}
  .nav-label{position:relative;z-index:1}
  .nav-tools{justify-self:end}
  .menu-toggle{display:none;position:relative;width:2.55rem;min-height:2.55rem;padding:0;border:0;background:transparent;cursor:pointer}
  .menu-toggle span{position:absolute;left:calc(50% - .48rem);width:.96rem;height:1.5px;border-radius:2px;background:currentColor;transition:transform .32s var(--ease-out)}
  .menu-toggle span:first-child{transform:translateY(-3.5px)}
  .menu-toggle span:last-child{transform:translateY(3.5px)}
  .menu-toggle[aria-expanded="true"] span:first-child{transform:rotate(45deg)}
  .menu-toggle[aria-expanded="true"] span:last-child{transform:rotate(-45deg)}
  .menu-scrim,.mobile-menu{display:none}
  @media(max-width:760px){
    .nav-bar{--glass-blur:16px;width:calc(100% - 1.25rem);margin-top:.5rem}
    .nav{width:100%;padding-inline:.45rem;grid-template-columns:minmax(0,1fr) auto;gap:.25rem}
    .desktop-links{display:none}
    .menu-toggle{display:inline-grid;place-items:center}
    .menu-scrim,.mobile-menu{display:block;visibility:hidden;opacity:0;transition:opacity .26s ease,visibility .26s}
    .menu-scrim{position:fixed;inset:0;background:rgb(9 14 16 / .26);-webkit-backdrop-filter:blur(5px);backdrop-filter:blur(5px)}
    .mobile-menu{--glass-fill:color-mix(in srgb,var(--color-surface) 86%,transparent);--glass-blur:24px;position:absolute;z-index:1;inset:calc(var(--nav-height) + 1rem) .625rem auto;width:auto;max-height:calc(100dvh - var(--nav-height) - 2rem);padding:.75rem clamp(1rem,6vw,3rem) 1.3rem;overflow:auto;overscroll-behavior:contain;border:1px solid var(--glass-rim);border-radius:1.35rem;background-image:linear-gradient(165deg,var(--glass-sheen),transparent 55%);box-shadow:inset 0 1px 0 var(--glass-rim),var(--glass-shadow);translate:0 -.55rem;transition:opacity .26s ease,translate .36s var(--ease-out),visibility .36s}
    .is-menu-open .menu-scrim,.is-menu-open .mobile-menu{visibility:visible;opacity:1;pointer-events:auto}
    .is-menu-open .mobile-menu{translate:0 0}
    .is-leaving .mobile-menu,.is-leaving .menu-scrim{visibility:hidden;transition:none}
    .mobile-menu a{display:flex;justify-content:start;min-height:2.9rem;padding:.45rem .9rem;font-size:1.08rem;font-weight:600;border-radius:1rem}
    .mobile-menu a[aria-current="page"]{background:var(--control-hover);color:var(--color-accent-strong)}
    .is-menu-open .mobile-menu a{animation:menu-in .32s var(--ease-out) both;animation-delay:calc(var(--i,0) * 24ms)}
    @keyframes menu-in{from{opacity:0;translate:0 -.35rem}}
  }
  @media(max-width:360px){.brand{padding-inline:.5rem}.nav-tools{gap:0}}
  @media(prefers-reduced-transparency:reduce){.menu-scrim{-webkit-backdrop-filter:none;backdrop-filter:none}}
</style>
