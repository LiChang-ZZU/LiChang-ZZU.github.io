---
import type { Locale } from '@/types';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<dialog class="bib-dialog glass-surface motion-dialog" aria-labelledby="bib-dialog-title">
  <form method="dialog">
    <div class="dialog-head">
      <h2 id="bib-dialog-title">BibTeX</h2>
      <button class="icon-button" value="close" aria-label={locale === 'zh' ? '关闭' : 'Close'}>×</button>
    </div>
    <pre><code></code></pre>
    <button class="button copy-bib" type="button" data-copied={locale === 'zh' ? '已复制' : 'Copied'}>{locale === 'zh' ? '复制 BibTeX' : 'Copy BibTeX'}</button>
  </form>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('.bib-dialog');
  const code = dialog?.querySelector('code');
  const copy = dialog?.querySelector<HTMLButtonElement>('.copy-bib');
  if (dialog && code && copy) {
    const copyLabel = copy.textContent;
    let trigger: HTMLElement | null = null;
    for (const button of document.querySelectorAll<HTMLButtonElement>('.bibtex-open')) {
      button.addEventListener('click', () => {
        trigger = button;
        code.textContent = button.dataset.bibtex ?? '';
        copy.textContent = copyLabel;
        dialog.showModal();
      });
    }
    dialog.addEventListener('close', () => trigger?.focus());
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    copy.addEventListener('click', async () => {
      await navigator.clipboard.writeText(code.textContent ?? '');
      copy.textContent = copy.dataset.copied ?? copyLabel;
    });
  }
</script>
<style>
  .bib-dialog{width:min(calc(100% - 2rem),42rem);padding:0;border-radius:var(--radius-lg);color:var(--color-text)}
  .bib-dialog::backdrop{background:rgb(0 0 0 / .42);backdrop-filter:blur(min(6px,var(--glass-blur)))}
  .bib-dialog form{padding:1.25rem}
  .dialog-head{display:flex;align-items:center;justify-content:space-between}
  .dialog-head h2{margin:0}
  .dialog-head button{display:grid;place-items:center;width:2.7rem;height:2.7rem;padding:0;border:1px solid var(--control-rim);border-radius:50%;background:var(--control-fill);font-size:1.45rem;line-height:1;cursor:pointer}
  .bib-dialog pre{overflow:auto;padding:1rem;background:var(--color-bg);border-radius:var(--radius-md);white-space:pre-wrap;font-size:.78rem}
</style>
