---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import SectionHeader from './SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';
import PublicationCard from './PublicationCard.astro';
import BibtexDialog from './BibtexDialog.astro';
import NewsList from './NewsList.astro';
import BlogCard from './BlogCard.astro';
import site from '@/data/site';
import type { Locale } from '@/types';
import { assetUrl, getLocalizedPath } from '@/utils/urls';
import { isPublished, sortByDate } from '@/utils/content';
import { getPhotos, photoText, photoImage } from '@/utils/photos';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const [projectsRaw, pubsRaw, newsRaw, postsRaw, photos] = await Promise.all([
  getCollection('projects'), getCollection('publications'), getCollection('news'), getCollection('blog'), getPhotos()
]);
const projects = sortByDate(projectsRaw.filter((item) => item.data.locale === locale && item.data.featured && isPublished(item))).slice(0, 3);
const publications = pubsRaw.filter((item) => item.data.locale === locale && item.data.featured && isPublished(item))
  .sort((a, b) => b.data.year - a.data.year).slice(0, 4);
const news = sortByDate(newsRaw.filter((item) => item.data.locale === locale && isPublished(item))).slice(0, 4);
const posts = sortByDate(postsRaw.filter((item) => item.data.locale === locale && isPublished(item))).slice(0, 3);
const topics = zh ? site.researchInterests : site.researchInterestsEn;
const homepageCover = photos.find(({ data }) => data.image === site.avatar);
const photo = photos.find(({ data }) => data.image !== site.avatar);
const cover = photo && photoImage(photo.data.image, photo.data.maxSize, photo.data.compress);
---
<BaseLayout {locale}>
  <div data-pagefind-body>
    <Hero {locale} cover={homepageCover} />
    {(topics.length > 0 || projects.length > 0 || publications.length > 0) && <section class="section research">
      <div class="container">
        <header class="research-intro" data-reveal="fade-up">
          <h2 class="display-title">{zh ? '研究' : 'Research'}</h2>
          {topics.length > 0 && <ul class="topic-list">{topics.map((topic) => <li>{topic}</li>)}</ul>}
          <a class="text-link" href={getLocalizedPath(locale, '/research/')}>{zh ? '查看全部研究' : 'View all research'}</a>
        </header>
        {publications.length > 0 && <div class:list={['home-publications', { 'single-publication': publications.length === 1 }]} aria-label={zh ? '代表论文' : 'Selected publications'}>
          {publications.map((publication) => <PublicationCard {publication} {locale} />)}
        </div>}
        {projects.map((project, index) => <ProjectCard {project} {locale} {index} />)}
      </div>
    </section>}
    {news.length > 0 && <section class="section">
      <div class="container news-layout">
        <SectionHeader title={zh ? '最新动态' : 'Latest news'} link={getLocalizedPath(locale, '/news/')} linkLabel={zh ? '全部动态' : 'All news'} />
        <NewsList items={news} {locale} />
      </div>
    </section>}
    <section class="section home-interests">
      <div class="container">
        <SectionHeader title={zh ? '兴趣' : 'Interests'} />
        {photo && cover ? <a class="photo-feature pressable" href={getLocalizedPath(locale, '/interests/')} data-reveal="scale" aria-label={zh ? '浏览摄影相册' : 'Browse photography gallery'}>
          <img src={assetUrl(cover.src)} srcset={cover.srcset} sizes="(max-width: 1200px) 95vw, 1152px"
            width={cover.width || undefined} height={cover.height || undefined} alt={photoText(photo.data, locale).alt} loading="lazy" decoding="async" />
          <div class="photo-feature-copy"><span>{zh ? '摄影' : 'Photography'}</span><strong>{photoText(photo.data, locale).title}</strong></div>
        </a> : <a class="interest-entry pressable" href={getLocalizedPath(locale, '/interests/')} data-reveal="fade-up">
          <strong>{zh ? '摄影' : 'Photography'}</strong>
          <span>{zh ? '浏览相册' : 'View gallery'}</span>
        </a>}
      </div>
    </section>
    {posts.length > 0 && <section class="section"><div class="container">
      <SectionHeader title={zh ? '最近写作' : 'Latest writing'} link={getLocalizedPath(locale, '/blog/')} linkLabel={zh ? '全部文章' : 'All writing'} />
      <div class="blog-grid">{posts.map((post) => <BlogCard {post} {locale} />)}</div>
    </div></section>}
  </div>
  {publications.length > 0 && <BibtexDialog {locale} />}
</BaseLayout>
<style>
  .research{padding-block:clamp(3.2rem,6.5vw,6.5rem);background:var(--color-surface)}
  .research-intro{display:grid;justify-items:center;gap:.95rem;margin:0 0 clamp(1.8rem,4vw,3.75rem);text-align:center}
  .topic-list{display:flex;flex-wrap:wrap;justify-content:center;gap:.4rem 1.2rem;margin:0;padding:0;list-style:none;color:var(--color-muted);font-size:var(--text-base)}
  .topic-list li{display:flex;align-items:center;gap:.6rem}
  .topic-list li::before{content:"";width:.26rem;height:.26rem;border-radius:50%;background:currentColor}
  .home-publications,.blog-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,18rem),1fr));gap:1rem;margin-bottom:1rem}
  .home-publications :global(.publication){background:var(--color-bg);padding:clamp(1rem,2.5vw,1.75rem);border-radius:var(--radius-md)}
  .single-publication :global(.publication:has(.pub-thumb)){display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:clamp(1.5rem,4vw,3rem);align-items:center}
  .single-publication :global(.pub-thumb){margin:0;aspect-ratio:1.65;object-fit:contain;background:#fff}
  .single-publication :global(.pub-title){font-size:clamp(1.15rem,1rem + .55vw,1.5rem)}
  .news-layout{display:grid;grid-template-columns:minmax(12rem,.38fr) minmax(0,1fr);gap:1.3rem clamp(1.5rem,7vw,7rem)}
  .news-layout :global(.section-header){display:flex;flex-direction:column;align-items:start;margin:0}
  .home-interests{background:var(--color-surface)}
  .interest-entry{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.6rem 1rem;padding:clamp(1.1rem,3vw,2rem);border:1px solid var(--color-line);border-radius:var(--radius-lg);background:var(--color-bg);text-decoration:none;transition:background var(--transition-base)}
  .interest-entry:hover{background:var(--color-accent-soft)}
  .interest-entry strong{font-size:var(--text-xl);letter-spacing:-.025em}
  .interest-entry span{color:var(--color-accent-strong);font-weight:600}
  .photo-feature{position:relative;display:grid;align-items:end;min-height:clamp(17rem,40vw,33rem);overflow:hidden;isolation:isolate;border-radius:var(--radius-lg);background:#152322;color:#fff;text-decoration:none}
  .photo-feature::after,.photo-feature img{position:absolute;inset:0;width:100%;height:100%;z-index:-1}
  .photo-feature::after{content:"";background:linear-gradient(0deg,rgb(0 0 0 / .68),transparent 65%)}
  .photo-feature img{object-fit:cover;object-position:50% 58%;transition:transform .65s var(--ease-out)}
  .photo-feature:hover img{transform:scale(1.025)}
  .photo-feature-copy{display:grid;gap:.2rem;padding:clamp(1.3rem,4vw,3rem)}
  .photo-feature-copy span{font-size:var(--text-sm)}
  .photo-feature-copy strong{font-size:var(--text-2xl);letter-spacing:-.035em;line-height:1.2}
  @media(max-width:700px){.single-publication :global(.publication:has(.pub-thumb)),.news-layout{grid-template-columns:1fr}}
</style>
