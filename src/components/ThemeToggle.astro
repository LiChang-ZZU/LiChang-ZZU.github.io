---
import type { Locale } from '@/types';
interface Props { locale: Locale }
const { locale } = Astro.props;
const label = locale === 'zh' ? '切换深浅色模式' : 'Toggle light and dark mode';
---
<button class="theme-toggle nav-control" type="button" aria-label={label} title={label}>
  <span aria-hidden="true" class="theme-icon">◐</span>
</button>
<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  if (button) {
    const root = document.documentElement;
    const system = matchMedia('(prefers-color-scheme: dark)');
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let fadeTimer: number | undefined;
    const isDark = () => root.dataset.theme ? root.dataset.theme === 'dark' : system.matches;
    const sync = () => button.setAttribute('aria-pressed', String(isDark()));
    const restore = () => {
      try {
        const stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') root.dataset.theme = stored;
      } catch {}
      sync();
    };
    const commit = (theme: 'light' | 'dark') => {
      root.dataset.theme = theme;
      try { localStorage.setItem('theme', theme); } catch {}
      sync();
      document.dispatchEvent(new CustomEvent('themechange', { detail: theme }));
    };

    restore();
    addEventListener('pageshow', restore);
    system.addEventListener('change', sync);
    button.addEventListener('click', () => {
      const theme = isDark() ? 'light' : 'dark';
      if (motion.matches) {
        commit(theme);
        return;
      }
      if (!document.startViewTransition) {
        root.classList.add('theme-fade');
        commit(theme);
        clearTimeout(fadeTimer);
        fadeTimer = window.setTimeout(() => root.classList.remove('theme-fade'), 290);
        return;
      }
      if (root.hasAttribute('data-theme-motion')) return;
      root.dataset.themeMotion = '';
      const transition = document.startViewTransition(() => commit(theme));
      const finish = () => { delete root.dataset.themeMotion; };
      void transition.finished.then(finish, finish);
    });
  }
</script>
<style>
  .theme-toggle{padding:0;border:0;background-color:transparent;cursor:pointer}
  .theme-icon{display:block;font-size:1.16rem;line-height:1;transition:rotate .38s var(--ease-out)}
  .theme-toggle[aria-pressed="true"] .theme-icon{rotate:180deg}
</style>
