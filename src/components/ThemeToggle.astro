---
import type { Locale } from '@/types';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<button class="theme-toggle" type="button" aria-label={locale === 'zh' ? '切换深浅色模式' : 'Toggle light and dark mode'} title={locale === 'zh' ? '切换浅色 / 深色' : 'Toggle light / dark'}>
  <span aria-hidden="true" class="theme-icon">◐</span><span class="theme-label">{locale === 'zh' ? '主题' : 'Theme'}</span>
</button>
<script>
  const setupTheme = () => {
    document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
      if (button.dataset.ready) return; button.dataset.ready = 'true';
      const root = document.documentElement;
      const media = matchMedia('(prefers-color-scheme: dark)');
      const current = () => root.dataset.theme === 'dark' || root.dataset.theme === 'light' ? root.dataset.theme : (media.matches ? 'dark' : 'light');
      const storedTheme = () => {
        try { const value = localStorage.getItem('theme'); return value === 'light' || value === 'dark' ? value : null; } catch { return null; }
      };
      // 刷新/从往返缓存恢复时，确保页面主题与已保存的偏好一致
      const sync = () => { const theme = storedTheme(); if (theme) root.dataset.theme = theme; };
      sync(); addEventListener('pageshow', sync);
      const apply = (theme: 'light' | 'dark') => {
        root.dataset.theme = theme;
        try { localStorage.setItem('theme', theme); } catch {}
        document.dispatchEvent(new CustomEvent('themechange', { detail: theme }));
      };
      button.addEventListener('click', () => apply(current() === 'dark' ? 'light' : 'dark'));
    });
  };
  setupTheme(); document.addEventListener('astro:after-swap', setupTheme);
</script>
<style>
  .theme-toggle { display:inline-flex; align-items:center; gap:.42rem; min-height:2.4rem; padding:.45rem .7rem; border:0; border-radius:999px; background:transparent; cursor:pointer; font-size:.82rem; }
  .theme-toggle:hover { background:var(--color-accent-soft); }
  .theme-icon { font-size:1.05rem; line-height:1; }
  @media(max-width:900px){.theme-label{display:none}}
</style>
